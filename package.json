{
    "name": "@zone-eu/mailsplit",
    "version": "5.4.27",
    "description": "Split email messages into an object stream",
    "main": "index.js",
    "types": "index.d.ts",
    "engines": {
        "node": ">=20.0.0"
    },
    "directories": {
        "test": "test"
    },
    "scripts": {
        "test": "node --test test/*-test.js",
        "test:cjs": "NODE_OPTIONS=--no-experimental-require-module npm test",
        "test:coverage": "c8 npm test",
        "lint": "npm run typecheck && eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc -p tsconfig.json",
        "update": "rm -rf node_modules package-lock.json && ncu -u && npm install"
    },
    "author": "Andris Reinman",
    "license": "(MIT OR EUPL-1.1+)",
    "dependencies": {
        "libbase64": "1.4.1",
        "libmime": "5.5.2",
        "libqp": "3.0.1"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/libmime": "5.3.0",
        "@types/libqp": "1.1.3",
        "@types/node": "26.6.5",
        "c8": "12.0.0",
        "eslint": "10.13.0",
        "eslint-config-prettier": "10.1.8",
        "globals": "17.13.0",
        "prettier": "3.9.10",
        "random-message": "1.1.0",
        "typescript": "7.0.2"
    },
    "files": [
        "lib",
        "index.js",
        "index.d.ts"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/zone-eu/mailsplit.git"
    }
}
